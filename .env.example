# Required later when the agent starts calling OpenAI.
OPENAI_API_KEY=

# Optional semantic parser for fuzzy Chinese prompts, aliases, and intent extraction.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional future integration point for a Melon data service or scraper API.
MELON_DATA_PROVIDER_URL=

# Local-only Melon avatar upload. Do not commit a real Cookie.
MELON_COOKIE=
MELON_AVATAR_FIELD_NAME=
MELON_USER_AGENT=IS40; iPhone 26.3.1; 6.17.0; iPhone17,1
